# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the Owner to create employee accounts from
# /employees and for cashiers to sign in with a username (the server resolves
# username -> email). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Local demo mode (optional)
# -----------------------------------------------------------------------------
# Requires an explicit opt-in and only works outside production builds.
# Demo mode is ignored when the Supabase URL + anon key above are configured,
# and it is hard-disabled in `next build` / production deployments.
NEXT_PUBLIC_DEMO_MODE=true
